<!--
  Source2Toolkit reference HUD layout for IToolkitHud: text slots and the
  interaction prompt.

  The core addresses the panels by id; the ids are the contract (see
  IToolkitHud.h). Positions, fonts and colours are in s2t_hud.css.

  Nothing here takes the mouse (hittest="false" everywhere): the player keeps
  playing while a text is up. Every slot is authored hidden and shown per
  player with the `show` class; colour (c-*) and size (s-*) classes come from
  the core too.

  Ids:
    hud_top, hud_topleft, hud_topright, hud_left, hud_right, hud_center,
    hud_bottom, hud_panel        one Panel per HudSlot (show, c-*, s-*)
    <slot>_text                  Label {s:text}
    hud_prompt                   the prompt (show)
    hud_prompt_key               Label {s:text}
    hud_prompt_text              Label {s:text}
    hud_prompt_barwrap           Panel (show)
    hud_prompt_bar               Panel (w0 .. w20)
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/s2t_hud.vcss_c" />
	</styles>

	<Panel class="s2t-hud-screen" hittest="false">

		<Panel id="hud_top" class="s2t-hud-slot s2t-hud-top" hittest="false">
			<Label id="hud_top_text" class="s2t-hud-text" text="{s:text}" />
		</Panel>
		<Panel id="hud_topleft" class="s2t-hud-slot s2t-hud-topleft" hittest="false">
			<Label id="hud_topleft_text" class="s2t-hud-text" text="{s:text}" />
		</Panel>
		<Panel id="hud_topright" class="s2t-hud-slot s2t-hud-topright" hittest="false">
			<Label id="hud_topright_text" class="s2t-hud-text" text="{s:text}" />
		</Panel>
		<Panel id="hud_left" class="s2t-hud-slot s2t-hud-left" hittest="false">
			<Label id="hud_left_text" class="s2t-hud-text" text="{s:text}" />
		</Panel>
		<Panel id="hud_right" class="s2t-hud-slot s2t-hud-right" hittest="false">
			<Label id="hud_right_text" class="s2t-hud-text" text="{s:text}" />
		</Panel>
		<Panel id="hud_center" class="s2t-hud-slot s2t-hud-center" hittest="false">
			<Label id="hud_center_text" class="s2t-hud-text" text="{s:text}" />
		</Panel>
		<Panel id="hud_bottom" class="s2t-hud-slot s2t-hud-bottom" hittest="false">
			<Label id="hud_bottom_text" class="s2t-hud-text" text="{s:text}" />
		</Panel>

		<Panel id="hud_panel" class="s2t-hud-slot s2t-hud-panel" hittest="false">
			<Label id="hud_panel_text" class="s2t-hud-text s2t-hud-panel-text" text="{s:text}" />
		</Panel>

		<Panel id="hud_prompt" class="s2t-prompt" hittest="false">
			<Panel class="s2t-prompt-row" hittest="false">
				<Panel class="s2t-prompt-keycap" hittest="false">
					<Label id="hud_prompt_key" class="s2t-prompt-key" text="{s:text}" />
				</Panel>
				<Label id="hud_prompt_text" class="s2t-prompt-text" text="{s:text}" />
			</Panel>
			<Panel id="hud_prompt_barwrap" class="s2t-prompt-barwrap" hittest="false">
				<Panel id="hud_prompt_bar" class="s2t-prompt-bar" hittest="false" />
			</Panel>
		</Panel>

	</Panel>
</root>
